<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="{{ settings.color_bg_primary }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- unless settings.font_heading.system? and settings.font_body.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}

    {{ content_for_header }}

    {%- liquid
      assign heading_font = settings.font_heading
      assign body_font = settings.font_body
      assign body_font_bold = settings.font_body | font_modify: 'weight', 'bold'
      assign body_font_medium = settings.font_body | font_modify: 'weight', '+100'
    -%}

    {% style %}
      {{ heading_font | font_face: font_display: 'swap' }}
      {{ body_font | font_face: font_display: 'swap' }}
      {% if body_font_medium %}{{ body_font_medium | font_face: font_display: 'swap' }}{% endif %}
      {% if body_font_bold %}{{ body_font_bold | font_face: font_display: 'swap' }}{% endif %}

      :root {
        --rino-bg-primary: {{ settings.color_bg_primary }};
        --rino-bg-secondary: {{ settings.color_bg_secondary }};
        --rino-text-primary: {{ settings.color_text_primary }};
        --rino-text-secondary: {{ settings.color_text_secondary }};
        --rino-accent: {{ settings.color_accent }};
        --rino-border: {{ settings.color_border }};
        --rino-white: {{ settings.color_white }};
        --rino-black: {{ settings.color_black }};

        --rino-font-display: {{ heading_font.family }}, {{ heading_font.fallback_families }};
        --rino-font-display-weight: {{ heading_font.weight }};
        --rino-font-body: {{ body_font.family }}, {{ body_font.fallback_families }};
        --rino-font-body-weight: {{ body_font.weight }};

        --rino-heading-scale: {{ settings.heading_scale | divided_by: 100.0 }};
        --rino-body-scale: {{ settings.body_scale | divided_by: 100.0 }};
        --rino-page-width: {{ settings.page_width }}px;
        --rino-radius-card: {{ settings.card_radius }}px;
        --rino-radius-btn: {{ settings.button_radius }}px;
      }
    {% endstyle %}

    {{ 'rino.css' | asset_url | stylesheet_tag }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.RINO = {
        cartType: {{ settings.cart_type | json }},
        moneyFormat: {{ shop.money_format | json }},
        routes: {
          root: {{ routes.root_url | json }},
          cart_url: {{ routes.cart_url | json }},
          cart_add_url: {{ routes.cart_add_url | json }},
          cart_change_url: {{ routes.cart_change_url | json }},
          cart_update_url: {{ routes.cart_update_url | json }},
          search_url: {{ routes.search_url | json }}
        },
        strings: {
          addToCart: {{ 'products.product.add_to_cart' | t | json }},
          adding: {{ 'products.product.adding' | t | json }},
          soldOut: {{ 'products.product.sold_out' | t | json }},
          unavailable: {{ 'products.product.unavailable' | t | json }},
          cartError: {{ 'cart.general.error' | t | json }},
          remove: {{ 'cart.general.remove' | t | json }},
          emptyCart: {{ 'cart.general.empty' | t | json }}
        }
      };
    </script>
    <script src="{{ 'rino.js' | asset_url }}" defer="defer"></script>
  </head>

  <body class="rino-body template-{{ template.name | handle }}">
    <a class="skip-to-content-link" href="#MainContent">
      {{ 'general.accessibility.skip_to_content' | t }}
    </a>

    {% sections 'header-group' %}

    <main id="MainContent" class="rino-main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- if settings.cart_type == 'drawer' -%}
      {% render 'cart-drawer' %}
    {%- endif -%}

    <div id="RinoLiveRegion" class="visually-hidden" aria-live="polite" aria-atomic="true"></div>
  </body>
</html>
