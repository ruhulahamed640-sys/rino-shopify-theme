[
  {
    "name": "theme_info",
    "theme_name": "RINO Streetwear",
    "theme_version": "1.0.0",
    "theme_author": "RINO Studio",
    "theme_documentation_url": "https://github.com/rino-studio/rino-shopify-theme",
    "theme_support_url": "https://github.com/rino-studio/rino-shopify-theme/issues"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "header",
        "content": "Brand Palette"
      },
      {
        "type": "color",
        "id": "color_bg_primary",
        "label": "Primary background",
        "default": "#111111"
      },
      {
        "type": "color",
        "id": "color_bg_secondary",
        "label": "Secondary surface",
        "default": "#191919"
      },
      {
        "type": "color",
        "id": "color_text_primary",
        "label": "Primary text",
        "default": "#F4F1EB"
      },
      {
        "type": "color",
        "id": "color_text_secondary",
        "label": "Secondary text",
        "default": "#A5A19A"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent orange",
        "default": "#FF5A1F"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Border",
        "default": "#333333"
      },
      {
        "type": "color",
        "id": "color_white",
        "label": "Pure white",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_black",
        "label": "Pure black",
        "default": "#000000"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Display heading font",
        "default": "oswald_n6"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body font",
        "default": "dm_sans_n4"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "min": 90,
        "max": 130,
        "step": 5,
        "unit": "%",
        "label": "Heading scale",
        "default": 100
      },
      {
        "type": "range",
        "id": "body_scale",
        "min": 90,
        "max": 120,
        "step": 5,
        "unit": "%",
        "label": "Body text scale",
        "default": 100
      }
    ]
  },
  {
    "name": "Layout & Components",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1100,
        "max": 1600,
        "step": 40,
        "unit": "px",
        "label": "Maximum container width",
        "default": 1380
      },
      {
        "type": "range",
        "id": "card_radius",
        "min": 0,
        "max": 32,
        "step": 2,
        "unit": "px",
        "label": "Card & container border radius",
        "default": 24
      },
      {
        "type": "range",
        "id": "button_radius",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "label": "Button & input border radius",
        "default": 12
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart behavior",
        "options": [
          {
            "value": "drawer",
            "label": "Slide-over drawer"
          },
          {
            "value": "page",
            "label": "Cart page"
          }
        ],
        "default": "drawer"
      },
      {
        "type": "checkbox",
        "id": "cart_show_note",
        "label": "Enable order note",
        "default": true
      },
      {
        "type": "text",
        "id": "cart_shipping_notice",
        "label": "Cart shipping notice",
        "default": "Taxes and international shipping calculated at checkout."
      }
    ]
  },
  {
    "name": "Social Media",
    "settings": [
      {
        "type": "url",
        "id": "social_instagram_link",
        "label": "Instagram URL"
      },
      {
        "type": "url",
        "id": "social_tiktok_link",
        "label": "TikTok URL"
      },
      {
        "type": "url",
        "id": "social_youtube_link",
        "label": "YouTube URL"
      },
      {
        "type": "url",
        "id": "social_twitter_link",
        "label": "X / Twitter URL"
      }
    ]
  },
  {
    "name": "Brand & Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon image",
        "info": "Recommended 32x32px PNG."
      },
      {
        "type": "text",
        "id": "brand_tagline",
        "label": "Brand tagline",
        "default": "WEAR YOUR IDENTITY."
      }
    ]
  }
]
