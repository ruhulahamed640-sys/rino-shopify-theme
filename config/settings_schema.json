  },
  {
    "name": "RINO — Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_bg_primary",
        "label": "Primary background",
        "default": "#111111"
      },
      {
        "type": "color",
        "id": "color_bg_secondary",
        "label": "Secondary background",
        "default": "#191919"
      },
      {
        "type": "color",
        "id": "color_text_primary",
        "label": "Primary text",
        "default": "#F4F1EB"
      },
      {
        "type": "color",
        "id": "color_text_secondary",
        "label": "Secondary text",
        "default": "#A5A19A"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent",
        "default": "#FF5A1F"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Border",
        "default": "#333333"
      },
      {
        "type": "color",
        "id": "color_white",
        "label": "White",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_black",
        "label": "Black",
        "default": "#000000"
      }
    ]
  },
  {
    "name": "RINO — Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Display / heading font",
        "default": "oswald_n6"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body font",
        "default": "dm_sans_n4"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "label": "Heading scale",
        "min": 80,
        "max": 130,
        "step": 5,
        "unit": "%",
        "default": 100
      },
      {
        "type": "range",
        "id": "body_scale",
        "label": "Body scale",
        "min": 85,
        "max": 120,
        "step": 5,
        "unit": "%",
        "default": 100
      }
    ]
  },
  {
    "name": "RINO — Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "Maximum page width",
        "min": 960,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "default": 1380
      },
      {
        "type": "range",
        "id": "card_radius",
        "label": "Card corner radius",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "default": 24
      },
      {
        "type": "range",
        "id": "button_radius",
        "label": "Button corner radius",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "default": 12
      }
    ]
  },
  {
    "name": "RINO — Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart behavior",
        "options": [
          {
            "value": "drawer",
            "label": "Drawer"
          },
          {
            "value": "page",
            "label": "Cart page"
          }
        ],
        "default": "drawer"
      },
      {
        "type": "checkbox",
        "id": "cart_show_note",
        "label": "Enable order note",
        "default": true
      },
      {
        "type": "text",
        "id": "cart_shipping_notice",
        "label": "Shipping notice",
        "default": "Taxes and international shipping calculated at checkout."
      }
    ]
  },
  {
    "name": "RINO — Brand",
    "settings": [
      {
        "type": "text",
        "id": "brand_tagline",
        "label": "Brand tagline",
        "default": "WEAR YOUR IDENTITY."
      }
    ]
  }
]
