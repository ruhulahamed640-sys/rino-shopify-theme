<section
  class="rino-section"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="rino-container">
    <div class="rino-newsletter-card">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <span class="rino-eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="rino-heading-lg">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subtext != blank -%}
          <p class="rino-muted" style="margin-top: 0.75rem; max-width: 46ch;">
            {{ section.settings.subtext | escape }}
          </p>
        {%- endif -%}
      </div>

      <div>
        {%- form 'customer', id: 'RinoNewsletterForm', class: 'rino-newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="rino-newsletter-form__row">
            <label for="NewsletterEmail-{{ section.id }}" class="visually-hidden">
              {{ 'sections.newsletter.label' | t }}
            </label>
            <input
              id="NewsletterEmail-{{ section.id }}"
              type="email"
              name="contact[email]"
              class="rino-input"
              value="{{ form.email }}"
              placeholder="{{ 'sections.newsletter.placeholder' | t }}"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              {% if form.errors %}aria-invalid="true"{% endif %}
              required
            >
            <button type="submit" class="rino-btn rino-btn--primary">
              {{ section.settings.button_label | default: 'sections.newsletter.button_label' | t }}
            </button>
          </div>

          {%- if form.posted_successfully? -%}
            <p class="rino-form-status rino-form-status--success" role="status">
              {{ 'sections.newsletter.success' | t }}
            </p>
          {%- endif -%}

          {%- if form.errors -%}
            <p class="rino-form-status rino-form-status--error" role="alert">
              {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
            </p>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "INNER CIRCLE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FIRST ACCESS TO EVERY DROP."
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Description",
      "default": "Unlock private drop passwords, limited studio runs, and international restock alerts."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "JOIN THE DROP"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 8,
      "unit": "px",
      "label": "Top padding",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 8,
      "unit": "px",
      "label": "Bottom padding",
      "default": 68
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
