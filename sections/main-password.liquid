<section class="rino-password">
  <div class="rino-password__card">
    <div style="display: flex; justify-content: center;">
      <img
        src="{{ 'icon-rino-mark.svg' | asset_url }}"
        alt="{{ shop.name | escape }}"
        width="160"
        height="39"
        loading="eager"
      >
    </div>

    <div>
      <span class="rino-eyebrow">{{ section.settings.eyebrow | escape }}</span>
      <h1 class="rino-heading-lg">
        {%- if section.settings.heading != blank -%}
          {{ section.settings.heading | escape }}
        {%- else -%}
          {{ 'general.password_page.opening_soon' | t }}
        {%- endif -%}
      </h1>
      {%- if shop.password_message != blank -%}
        <p class="rino-muted" style="margin-top: 0.75rem;">{{ shop.password_message }}</p>
      {%- elsif section.settings.subtext != blank -%}
        <p class="rino-muted" style="margin-top: 0.75rem;">{{ section.settings.subtext | escape }}</p>
      {%- endif -%}
    </div>

    {%- form 'storefront_password', class: 'rino-form-grid' -%}
      {%- if form.errors -%}
        <div class="rino-form-status rino-form-status--error" role="alert">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <div style="text-align: left;">
        <label for="PasswordInput" class="rino-label">{{ 'general.password_page.login_form_password_label' | t }}</label>
        <input
          id="PasswordInput"
          type="password"
          name="password"
          class="rino-input"
          placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}"
          autocomplete="current-password"
          required
        >
      </div>

      <button type="submit" class="rino-btn rino-btn--primary rino-btn--full">
        {{ 'general.password_page.login_form_submit' | t }}
      </button>
    {%- endform -%}

    <p class="rino-muted" style="font-size: 0.8125rem;">
      {{ 'general.password_page.admin_link_html' | t }}
    </p>
  </div>
</section>

{% schema %}
{
  "name": "Password Gate",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "RINO STUDIO"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "DROP INCOMING."
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Message",
      "default": "We are preparing the next custom-printed RINO release. Enter the access password below."
    }
  ]
}
{% endschema %}
