<section
  class="rino-hero"
  style="
    --hero-min-height-desktop: {{ section.settings.height_desktop }}px;
    --hero-min-height-mobile: {{ section.settings.height_mobile }}px;
    --hero-pos: {{ section.settings.image_position }};
    --hero-brightness: {{ section.settings.image_brightness | divided_by: 100.0 }};
    --hero-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  "
>
  <div class="rino-container">
    <div class="rino-hero__frame">
      <div class="rino-hero__media">
        {%- if section.settings.image != blank -%}
          <picture>
            {%- if section.settings.mobile_image != blank -%}
              <source
                media="(max-width: 749px)"
                srcset="{{ section.settings.mobile_image | image_url: width: 900 }}"
              >
            {%- endif -%}
            {{
              section.settings.image
              | image_url: width: 2000
              | image_tag:
                loading: 'eager',
                fetchpriority: 'high',
                widths: '750, 1100, 1500, 2000',
                sizes: '100vw',
                class: 'rino-hero__img',
                alt: section.settings.heading
            }}
          </picture>
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'rino-hero__img rino-placeholder-svg' }}
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="rino-promo-slider rino-promo-slider--hero" data-rino-promo-slider aria-label="New products and offers">
          <div class="rino-promo-slider__track">
            {%- for block in section.blocks -%}
              {%- assign promo_product = block.settings.product -%}
              {%- assign promo_image = block.settings.image | default: promo_product.featured_image -%}
              {%- assign promo_heading = block.settings.heading | default: promo_product.title -%}
              {%- assign promo_link = block.settings.link | default: promo_product.url -%}
              <article class="rino-promo-slide{% if forloop.first %} is-active{% endif %}" data-rino-promo-slide aria-hidden="{% unless forloop.first %}true{% else %}false{% endunless %}" {{ block.shopify_attributes }}>
                {%- if promo_image != blank -%}
                  <div class="rino-promo-slide__image">{{ promo_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(max-width: 749px) 88vw, 520px', alt: promo_heading }}</div>
                {%- else -%}
                  <div class="rino-promo-slide__image rino-promo-slide__image--placeholder" aria-hidden="true">{{ 'product-1' | placeholder_svg_tag }}</div>
                {%- endif -%}
                <div class="rino-promo-slide__content">
                  {%- if block.settings.kicker != blank -%}<span class="rino-promo-slide__kicker">{{ block.settings.kicker | escape }}</span>{%- endif -%}
                  {%- if promo_heading != blank -%}<h2 class="rino-promo-slide__heading">{{ promo_heading | escape }}</h2>{%- endif -%}
                  {%- if block.settings.description != blank -%}<p>{{ block.settings.description | escape }}</p>{%- endif -%}
                  {%- if block.settings.button_label != blank and promo_link != blank -%}<a class="rino-promo-slide__link" href="{{ promo_link }}">{{ block.settings.button_label | escape }} <span aria-hidden="true">→</span></a>{%- endif -%}
                </div>
              </article>
            {%- endfor -%}
          </div>
          {%- if section.blocks.size > 1 -%}
            <div class="rino-promo-slider__controls">
              <div class="rino-promo-slider__dots" role="group" aria-label="Choose promotion">
                {%- for block in section.blocks -%}<button type="button" class="rino-promo-slider__dot{% if forloop.first %} is-active{% endif %}" data-rino-promo-dot="{{ forloop.index0 }}" aria-label="Show slide {{ forloop.index }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"></button>{%- endfor -%}
              </div>
              <span class="rino-promo-slider__counter"><span data-rino-promo-current>01</span> / {{ section.blocks.size | prepend: '0' | slice: -2, 2 }}</span>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="rino-hero__overlay" aria-hidden="true"></div>



      <div class="rino-hero__content align-{{ section.settings.text_alignment }}">
        {%- if section.settings.eyebrow != blank -%}
          <span class="rino-eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h1 class="rino-heading-xl">{{ section.settings.heading | escape }}</h1>
        {%- endif -%}

        {%- if section.settings.subtext != blank -%}
          <p class="rino-hero__subtitle">{{ section.settings.subtext | escape }}</p>
        {%- endif -%}

        <div class="rino-hero__actions">
          {%- if section.settings.primary_cta_label != blank -%}
            <a href="{{ section.settings.primary_cta_link | default: routes.all_products_collection_url }}" class="rino-btn rino-btn--primary">
              {{ section.settings.primary_cta_label | escape }}
              {% render 'icon', name: 'arrow-right', size: 18 %}
            </a>
          {%- endif -%}

          {%- if section.settings.secondary_cta_label != blank -%}
            <a href="{{ section.settings.secondary_cta_link | default: routes.all_products_collection_url }}" class="rino-btn rino-btn--secondary">
              {{ section.settings.secondary_cta_label | escape }}
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop editorial image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image (optional)"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image focal position",
      "options": [
        {
          "value": "center top",
          "label": "Top"
        },
        {
          "value": "center center",
          "label": "Center"
        },
        {
          "value": "center bottom",
          "label": "Bottom"
        }
      ],
      "default": "center center"
    },
    {
      "type": "range",
      "id": "image_brightness",
      "min": 40,
      "max": 110,
      "step": 5,
      "unit": "%",
      "label": "Image brightness",
      "default": 85
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 95,
      "step": 5,
      "unit": "%",
      "label": "Dark overlay opacity",
      "default": 75
    },
    {
      "type": "range",
      "id": "height_desktop",
      "min": 480,
      "max": 860,
      "step": 20,
      "unit": "px",
      "label": "Desktop height",
      "default": 680
    },
    {
      "type": "range",
      "id": "height_mobile",
      "min": 420,
      "max": 720,
      "step": 20,
      "unit": "px",
      "label": "Mobile height",
      "default": 540
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "RINO STUDIO — SEASON 01"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "OWN YOUR STREET."
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Supporting text",
      "default": "Heavyweight 280GSM custom-printed graphic tees built for bold urban silhouettes. Designed independently. Shipped worldwide."
    },
    {
      "type": "text",
      "id": "primary_cta_label",
      "label": "Primary CTA label",
      "default": "SHOP THE DROP"
    },
    {
      "type": "url",
      "id": "primary_cta_link",
      "label": "Primary CTA link"
    },
    {
      "type": "text",
      "id": "secondary_cta_label",
      "label": "Secondary CTA label",
      "default": "OUR STORY"
    },
    {
      "type": "url",
      "id": "secondary_cta_link",
      "label": "Secondary CTA link"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "promo_slide",
      "name": "Product / offer slide",
      "settings": [
        {
          "type": "text",
          "id": "kicker",
          "label": "Label",
          "default": "NEW DROP"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product (optional)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Slide image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "NEW SEASON. NEW ENERGY."
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "SHOP NOW"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button link"
        }
      ]
    }
  ]
}
{% endschema %}
