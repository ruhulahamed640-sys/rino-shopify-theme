<section
  class="rino-section"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="rino-container">
    <div class="rino-narrow">
      <span class="rino-eyebrow">{{ section.settings.eyebrow | escape }}</span>
      <h1 class="rino-heading-lg">{{ section.settings.heading | default: page.title | escape }}</h1>

      {%- if section.settings.subtext != blank -%}
        <p class="rino-muted" style="margin-top: 0.75rem; margin-bottom: 2rem;">
          {{ section.settings.subtext | escape }}
        </p>
      {%- endif -%}

      {%- if page.content != blank -%}
        <div class="rino-rte" style="margin-bottom: 2rem;">
          {{ page.content }}
        </div>
      {%- endif -%}

      <div class="rino-cart-summary">
        {%- form 'contact', id: 'RinoContactForm', class: 'rino-form-grid' -%}
          {%- if form.posted_successfully? -%}
            <p class="rino-form-status rino-form-status--success" role="status">
              {{ 'contact.form.post_success' | t }}
            </p>
          {%- endif -%}

          {%- if form.errors -%}
            <div class="rino-form-status rino-form-status--error" role="alert">
              <p><strong>{{ 'contact.form.error_heading' | t }}</strong></p>
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <div class="rino-form-grid rino-form-grid--2">
            <div>
              <label for="ContactFormName" class="rino-label">{{ 'contact.form.name' | t }}</label>
              <input
                id="ContactFormName"
                type="text"
                name="contact[name]"
                class="rino-input"
                value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                autocomplete="name"
                required
              >
            </div>
            <div>
              <label for="ContactFormEmail" class="rino-label">{{ 'contact.form.email' | t }}</label>
              <input
                id="ContactFormEmail"
                type="email"
                name="contact[email]"
                class="rino-input"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                autocomplete="email"
                spellcheck="false"
                autocapitalize="off"
                required
              >
            </div>
          </div>

          <div>
            <label for="ContactFormPhone" class="rino-label">{{ 'contact.form.phone' | t }}</label>
            <input
              id="ContactFormPhone"
              type="tel"
              name="contact[phone]"
              class="rino-input"
              value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
              autocomplete="tel"
            >
          </div>

          <div>
            <label for="ContactFormBody" class="rino-label">{{ 'contact.form.comment' | t }}</label>
            <textarea
              id="ContactFormBody"
              name="contact[body]"
              class="rino-textarea"
              required
            >{{ form.body }}</textarea>
          </div>

          <div>
            <button type="submit" class="rino-btn rino-btn--primary">
              {{ 'contact.form.send' | t }}
              {% render 'icon', name: 'arrow-right', size: 16 %}
            </button>
          </div>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact Form",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "DIRECT LINE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "GET IN TOUCH."
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Intro copy",
      "default": "Questions about sizing, international shipping, or wholesale drops? Send us a message below."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Top padding",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Bottom padding",
      "default": 80
    }
  ]
}
{% endschema %}
