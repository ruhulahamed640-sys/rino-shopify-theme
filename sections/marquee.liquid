<section
  class="rino-marquee"
  aria-label="{{ section.settings.accessible_label | escape }}"
  style="
    --marquee-bg: {{ section.settings.bg_color }};
    --marquee-text: {{ section.settings.text_color }};
    --marquee-speed: {{ section.settings.speed }}s;
  "
>
  <div class="rino-marquee__track">
    {%- for i in (1..2) -%}
      {%- for block in section.blocks -%}
        <span
          class="rino-marquee__item{% if i == 2 %} rino-marquee__item--duplicate{% endif %}"
          {% if i == 2 %}aria-hidden="true"{% endif %}
          {{ block.shopify_attributes }}
        >
          <span>{{ block.settings.text | escape }}</span>
          <span class="rino-marquee__dot" aria-hidden="true"></span>
        </span>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Marquee",
  "max_blocks": 10,
  "settings": [
    {
      "type": "text",
      "id": "accessible_label",
      "label": "Accessible label",
      "default": "Brand statement ticker"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "s",
      "label": "Scroll duration",
      "default": 24
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#191919"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#F4F1EB"
    }
  ],
  "blocks": [
    {
      "type": "statement",
      "name": "Statement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "NO RULES. JUST RINO."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Marquee",
      "blocks": [
        { "type": "statement", "settings": { "text": "NO RULES. JUST RINO." } },
        { "type": "statement", "settings": { "text": "WEAR YOUR IDENTITY." } },
        { "type": "statement", "settings": { "text": "HEAVYWEIGHT CUSTOM TEES" } },
        { "type": "statement", "settings": { "text": "NO RULES. JUST RINO." } }
      ]
    }
  ]
}
{% endschema %}
