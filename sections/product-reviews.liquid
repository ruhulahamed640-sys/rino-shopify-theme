{%- liquid
  assign rating_data = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value | default: 0
  assign rating_value = rating_data.rating
  assign rating_percent = rating_value | times: 20
-%}
<section class="rino-section rino-reviews" style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;">
  <div class="rino-container">
    <header class="rino-section__header">
      <div>
        <span class="rino-eyebrow">{{ section.settings.eyebrow | escape }}</span>
        <h2 class="rino-heading-md">{{ section.settings.heading | escape }}</h2>
      </div>
    </header>

    <div class="rino-reviews__summary">
      {%- if rating_value != blank and rating_count > 0 -%}
        <span class="rino-reviews__score">{{ rating_value | round: 1 }}</span>
        <div>
          <div class="rino-reviews__stars" aria-label="{{ rating_value }} out of 5 stars">
            <span aria-hidden="true">★★★★★</span>
            <span class="rino-reviews__stars-fill" style="--rating-percent: {{ rating_percent }}%;" aria-hidden="true">★★★★★</span>
          </div>
          <p class="rino-muted" style="margin-top:.4rem">{{ rating_count }} {{ section.settings.review_count_label | escape }}</p>
        </div>
      {%- else -%}
        <div class="rino-reviews__empty">
          <strong>{{ section.settings.empty_heading | escape }}</strong>
          <p style="margin-top:.35rem">{{ section.settings.empty_text | escape }}</p>
        </div>
      {%- endif -%}
    </div>

    {%- assign has_app_block = false -%}
    {%- for block in section.blocks -%}
      {%- if block.type == '@app' -%}
        {%- assign has_app_block = true -%}
        <div class="rino-reviews__app-block" {{ block.shopify_attributes }}>
          {% render block %}
        </div>
      {%- endif -%}
    {%- endfor -%}
    {%- unless has_app_block -%}
      <p class="rino-muted">{{ section.settings.app_hint | escape }}</p>
    {%- endunless -%}
  </div>
</section>

{% schema %}
{
  "name": "Product Reviews",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"REAL RINO CUSTOMERS"},
    {"type":"text","id":"heading","label":"Heading","default":"REVIEWS & RATINGS"},
    {"type":"text","id":"review_count_label","label":"Review count label","default":"verified reviews"},
    {"type":"text","id":"empty_heading","label":"Empty state heading","default":"NO REVIEWS YET"},
    {"type":"textarea","id":"empty_text","label":"Empty state text","default":"Be among the first customers to share feedback on this piece."},
    {"type":"text","id":"app_hint","label":"Reviews app hint","default":"Add a reviews app block in the Theme Editor to display customer reviews and the review submission form."},
    {"type":"range","id":"padding_top","min":20,"max":100,"step":10,"unit":"px","label":"Top padding","default":50},
    {"type":"range","id":"padding_bottom","min":20,"max":100,"step":10,"unit":"px","label":"Bottom padding","default":50}
  ],
  "blocks": [{"type":"@app"}],
  "presets": [{"name":"Product Reviews"}],
  "enabled_on": {"templates":["product"]}
}
{% endschema %}