{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'RinoProductForm-' | append: section.id
-%}

<section
  class="rino-section"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
  data-product-root
  data-product-handle="{{ product.handle }}"
>
  <div class="rino-container">
    <div class="rino-pdp">
      {%- comment -%} Product Media Gallery (Images, Video, External Video, 3D Model) {%- endcomment -%}
      <div class="rino-pdp__gallery" aria-label="{{ 'products.product.media.gallery_label' | t }}">
        <div class="rino-pdp__stage">
          {%- if product.media.size > 0 -%}
            {%- for media in product.media -%}
              {%- assign is_active = false -%}
              {%- if current_variant.featured_media != blank -%}
                {%- if media.id == current_variant.featured_media.id -%}
                  {%- assign is_active = true -%}
                {%- endif -%}
              {%- elsif forloop.first -%}
                {%- assign is_active = true -%}
              {%- endif -%}

              <div
                class="rino-pdp__media-item"
                data-media-item="{{ media.id }}"
                {% unless is_active %}hidden{% endunless %}
              >
                {%- case media.media_type -%}
                  {%- when 'image' -%}
                    {%- assign media_loading = 'lazy' -%}
                    {%- if is_active -%}{%- assign media_loading = 'eager' -%}{%- endif -%}
                    {{
                      media
                      | image_url: width: 1400
                      | image_tag:
                        loading: media_loading,
                        widths: '540, 800, 1100, 1400',
                        sizes: '(min-width: 990px) 55vw, 100vw',
                        alt: product.title
                    }}
                  {%- when 'video' -%}
                    {{ media | video_tag: controls: true, loop: true, muted: false, image_size: '1024x' }}
                  {%- when 'external_video' -%}
                    {{ media | external_video_tag: loading: 'lazy' }}
                  {%- when 'model' -%}
                    {{ media | model_viewer_tag: image_size: '1024x' }}
                {%- endcase -%}
              </div>
            {%- endfor -%}
          {%- else -%}
            <div class="rino-pdp__media-item">
              {{ 'product-1' | placeholder_svg_tag: 'rino-placeholder-svg' }}
            </div>
          {%- endif -%}
        </div>

        {%- if product.media.size > 1 -%}
          <div class="rino-pdp__thumbs" role="list" aria-label="{{ 'products.product.media.thumbnails_label' | t }}">
            {%- for media in product.media -%}
              {%- assign thumb_active = false -%}
              {%- if current_variant.featured_media != blank -%}
                {%- if media.id == current_variant.featured_media.id -%}
                  {%- assign thumb_active = true -%}
                {%- endif -%}
              {%- elsif forloop.first -%}
                {%- assign thumb_active = true -%}
              {%- endif -%}
              <button
                type="button"
                class="rino-pdp__thumb"
                data-media-thumb="{{ media.id }}"
                aria-current="{% if thumb_active %}true{% else %}false{% endif %}"
                aria-label="{{ media.alt | default: product.title | escape }} — {{ forloop.index }}"
              >
                {{
                  media.preview_image
                  | image_url: width: 220
                  | image_tag:
                    loading: 'lazy',
                    alt: product.title
                }}
                {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
                  <span class="rino-pdp__thumb-play" aria-hidden="true">
                    {% render 'icon', name: 'play', size: 18 %}
                  </span>
                {%- endif -%}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Product Details & Real Shopify Variant Purchase Form {%- endcomment -%}
      <div class="rino-pdp__info">
        <div>
          {%- if product.vendor != blank and section.settings.show_vendor -%}
            <span class="rino-eyebrow">{{ product.vendor | escape }}</span>
          {%- endif -%}
          <h1 class="rino-heading-lg">{{ product.title | escape }}</h1>
        </div>

        {% render 'price', product: product, use_variant: true, show_badges: true %}

        <div
          class="rino-pdp__availability{% unless current_variant.available %} is-sold-out{% endunless %}"
          data-product-availability
          data-in-stock-label="{{ 'products.product.in_stock' | t | escape }}"
          data-sold-out-label="{{ 'products.product.out_of_stock' | t | escape }}"
        >
          <span class="rino-pdp__availability-dot" aria-hidden="true"></span>
          <span data-product-availability-text>
            {%- if current_variant.available -%}
              {{ 'products.product.in_stock' | t }}
            {%- else -%}
              {{ 'products.product.out_of_stock' | t }}
            {%- endif -%}
          </span>
        </div>

        {%- unless product.has_only_default_variant -%}
          <div class="rino-variants">
            {%- for option in product.options_with_values -%}
              <fieldset class="rino-variant-group" data-option-group>
                <legend class="rino-variant-group__legend">
                  {{ option.name | escape }}:
                  <strong data-option-selected-value>{{ option.selected_value | escape }}</strong>
                </legend>
                <div class="rino-variant-pills">
                  {%- for value in option.values -%}
                    {%- assign input_id = 'Option-' | append: section.id | append: '-' | append: option.position | append: '-' | append: forloop.index0 -%}
                    <div class="rino-variant-pill">
                      <input
                        type="radio"
                        id="{{ input_id }}"
                        name="options[{{ option.name | escape }}]"
                        value="{{ value | escape }}"
                        {% if option.selected_value == value %}checked{% endif %}
                      >
                      <label for="{{ input_id }}">{{ value | escape }}</label>
                    </div>
                  {%- endfor -%}
                </div>
              </fieldset>
            {%- endfor -%}
          </div>
        {%- endunless -%}

        {%- form 'product', product, id: product_form_id, class: 'rino-pdp__buy-buttons', data-product-form: '' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}">

          <div class="rino-drawer__error" data-product-form-error role="alert" hidden></div>

          <div class="rino-pdp__form-row">
            <div class="rino-qty">
              <button
                type="button"
                class="rino-qty__btn"
                data-pdp-qty-btn
                data-delta="-1"
                aria-label="{{ 'products.product.quantity.decrease' | t: product: product.title | escape }}"
              >
                {% render 'icon', name: 'minus', size: 16 %}
              </button>
              <input
                type="number"
                name="quantity"
                value="1"
                min="1"
                class="rino-qty__input"
                data-pdp-qty-input
                aria-label="{{ 'products.product.quantity.label' | t }}"
              >
              <button
                type="button"
                class="rino-qty__btn"
                data-pdp-qty-btn
                data-delta="1"
                aria-label="{{ 'products.product.quantity.increase' | t: product: product.title | escape }}"
              >
                {% render 'icon', name: 'plus', size: 16 %}
              </button>
            </div>

            <button
              type="submit"
              name="add"
              class="rino-btn rino-btn--primary rino-btn--full"
              data-add-to-cart
              {% unless current_variant.available %}disabled{% endunless %}
            >
              <span data-add-to-cart-text>
                {%- if current_variant.available -%}
                  {{ 'products.product.add_to_cart' | t }}
                {%- else -%}
                  {{ 'products.product.sold_out' | t }}
                {%- endif -%}
              </span>
            </button>
          </div>

          {%- if section.settings.show_dynamic_checkout -%}
            <div class="rino-pdp__dynamic-checkout">
              {{ form | payment_button }}
            </div>
          {%- endif -%}
        {%- endform -%}

        {%- if product.description != blank -%}
          <div class="rino-rte">
            {{ product.description }}
          </div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="rino-accordions">
            {%- for block in section.blocks -%}
              {%- if block.type == 'accordion' -%}
                <details class="rino-accordion" {{ block.shopify_attributes }}{% if block.settings.open_default %} open{% endif %}>
                  <summary>
                    <span>{{ block.settings.heading | escape }}</span>
                    {% render 'icon', name: 'chevron-down', size: 18 %}
                  </summary>
                  <div class="rino-accordion__body rino-rte">
                    {{ block.settings.content }}
                  </div>
                </details>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  <script type="application/json" data-product-variants>
    {{ product.variants | json }}
  </script>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org/",
      "@type": "Product",
      "name": {{ product.title | json }},
      "url": {{ request.origin | append: product.url | json }},
      {% if product.featured_media %}
        "image": [{{ product.featured_media | image_url: width: 1200 | prepend: 'https:' | json }}],
      {% endif %}
      "description": {{ product.description | strip_html | json }},
      {% if current_variant.sku != blank %}
        "sku": {{ current_variant.sku | json }},
      {% endif %}
      "brand": {
        "@type": "Brand",
        "name": {{ product.vendor | default: shop.name | json }}
      },
      "offers": {
        "@type": "Offer",
        "url": {{ request.origin | append: current_variant.url | json }},
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "price": {{ current_variant.price | divided_by: 100.0 | json }},
        "availability": "https://schema.org/{% if current_variant.available %}InStock{% else %}OutOfStock{% endif %}"
      }
    }
  </script>
</section>

{% schema %}
{
  "name": "Product Information",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show brand / vendor label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show dynamic checkout button",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Bottom padding",
      "default": 70
    }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Information accordion",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "SIZE & FIT"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Boxy oversized streetwear cut. Available in XS, S, M, L, XL, and XXL. Take your true size for a relaxed drop-shoulder fit, or size down for a standard fit.</p>"
        },
        {
          "type": "checkbox",
          "id": "open_default",
          "label": "Open by default",
          "default": false
        }
      ]
    }
  ]
}
{% endschema %}
